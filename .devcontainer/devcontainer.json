{
 "name": "Flight Streamlit",
 "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
 "forwardPorts": [8501],
 "portsAttributes": {"8501": {"label": "Flight Dashboard", "onAutoForward": "openBrowser"}},
 "postCreateCommand": "pip install -r requirements.txt",
 "postStartCommand": "bash -lc 'nohup python -m streamlit run app.py > /tmp/flight-streamlit.log 2>&1 &'"
}
